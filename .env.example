# Environment example

DATABASE_URL=postgres://palbot:palbotpass@localhost:5432/palbotdb
JWT_SECRET=replace_with_secure_random
JWT_REFRESH_SECRET=replace_with_secure_random_refresh
MASTER_ENCRYPTION_KEY=base64:REPLACE_WITH_BASE64_32BYTE_KEY
PRICE_CACHE_BACKEND=memory
